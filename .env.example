# DiagNova – Beispielumgebung (keine echten Secrets committen)
# Produktion: starke Zufallswerte, chmod 600, siehe docs/world4you-plesk-install.md
POSTGRES_USER=diagnova
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=diagnova
DATABASE_URL=postgresql+psycopg://diagnova:changeme_local_only@postgres:5432/diagnova

# JWT – in Produktion durch starken Zufallswert ersetzen (nicht diesen Default)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# API
API_HOST=0.0.0.0
API_PORT=8000
# Lokal Dev; Produktion z. B. https://diagnova.codekreativ.at
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
DEMO_MODE=true

# Demo-Seed (nur Entwicklung)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminDemo123!
SEED_TECH_EMAIL=tech@example.com
SEED_TECH_PASSWORD=TechDemo123!

# Frontend (Build-Zeit)
VITE_API_URL=http://localhost:8000

# Phase 07 – Diagnosedaten-Updates (Scheduler standardmäßig aus)
UPDATE_SCHEDULER_ENABLED=false
UPDATE_INTERVAL_HOURS=24
UPDATE_FETCH_TIMEOUT_SEC=30
UPDATE_MAX_BYTES=2000000
UPDATE_MAX_RETRIES=3
UPDATE_HMAC_DEMO_SECRET=diagnova-phase07-demo-hmac-not-for-prod

# Phase 13 – Payment-Stub (kein echter PSP; nur Demo-HMAC)
PAYMENT_WEBHOOK_DEMO_SECRET=diagnova-phase13-payment-stub-hmac-not-for-prod
